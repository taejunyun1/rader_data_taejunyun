{
  "name": "research-radar",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:worker": "pnpm --filter @radar/worker run dev",
    "dev:web": "pnpm --filter @radar/web run dev",
    "build": "pnpm -r run build",
    "test:unit": "pnpm --filter @radar/web exec vitest run",
    "test:workers": "pnpm --filter @radar/worker test:run",
    "test:coverage": "pnpm --filter @radar/web exec vitest run --coverage && pnpm --filter @radar/worker test:coverage",
    "verify": "pnpm typecheck && pnpm test:workers && pnpm test:unit && pnpm build",
    "typecheck": "pnpm -r run typecheck",
    "deploy": "pnpm --filter @radar/web run build && pnpm --filter @radar/worker run deploy",
    "db:migrate": "pnpm --filter @radar/worker run db:migrate",
    "db:migrate:remote": "pnpm --filter @radar/worker run db:migrate:remote",
    "cf:typegen": "pnpm --filter @radar/worker run cf:typegen",
    "sync:obsidian": "node cli/obsidian-sync.mjs"
  }
}
